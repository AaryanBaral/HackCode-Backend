
mkdir TestCaseService && cd TestCaseService





dotnet new sln -n TestCaseService




dotnet new webapi -n TestCaseService.API
dotnet new classlib -n TestCaseService.Application
dotnet new classlib -n TestCaseService.Domain
dotnet new classlib -n TestCaseService.Infrastructure
dotnet new xunit -n TestCaseService.Tests




mkdir -p TestCaseService.API/{Controllers,Hubs,Middlewares,ExceptionHandling,Extensions}
mkdir -p TestCaseService.Application/{Interfaces,Services,DTOs,SignalR}
mkdir -p TestCaseService.Domain/{Entities,ValueObjects,Enums}
mkdir -p TestCaseService.Infrastructure/{Kafka,Persistence,Repository,DockerSandbox,SignalR}




dotnet add TestCaseService.API/TestCaseService.API.csproj reference TestCaseService.Application/TestCaseService.Application.csproj
dotnet add TestCaseService.API/TestCaseService.API.csproj reference TestCaseService.Infrastructure/TestCaseService.Infrastructure.csproj
dotnet add TestCaseService.Application/TestCaseService.Application.csproj reference TestCaseService.Domain/TestCaseService.Domain.csproj
dotnet add TestCaseService.Infrastructure/TestCaseService.Infrastructure.csproj reference TestCaseService.Application/TestCaseService.Application.csproj
dotnet add TestCaseService.Infrastructure/TestCaseService.Infrastructure.csproj reference TestCaseService.Domain/TestCaseService.Domain.csproj
dotnet add TestCaseService.Tests/TestCaseService.Tests.csproj reference TestCaseService.Application/TestCaseService.Application.csproj
dotnet add TestCaseService.Tests/TestCaseService.Tests.csproj reference TestCaseService.Domain/TestCaseService.Domain.csproj




dotnet sln add TestCaseService.API/TestCaseService.API.csproj
dotnet sln add TestCaseService.Application/TestCaseService.Application.csproj
dotnet sln add TestCaseService.Domain/TestCaseService.Domain.csproj
dotnet sln add TestCaseService.Infrastructure/TestCaseService.Infrastructure.csproj
dotnet sln add TestCaseService.Tests/TestCaseService.Tests.csproj